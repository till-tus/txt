<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="top"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <View
        android:id="@+id/pinnedNoteDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/pinned_note_dot"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/noteText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:textColor="@color/launcher_text"
        android:textSize="18sp" />

    <FrameLayout
        android:id="@+id/voiceNoteRow"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/playVoiceNoteButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="@string/play_voice_note"
            android:padding="11dp"
            android:src="@drawable/ic_play"
            app:tint="@color/launcher_text" />

        <com.example.textlauncher.ui.VoiceWaveformView
            android:id="@+id/voiceWaveform"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="48dp" />

        <TextView
            android:id="@+id/voiceNoteDuration"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical|end"
            android:includeFontPadding="false"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="13sp" />

    </FrameLayout>

    <ImageButton
        android:id="@+id/copyNoteButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/copy_note"
        android:padding="12dp"
        android:src="@drawable/ic_content_copy"
        app:tint="@color/launcher_text" />

</LinearLayout>
