<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="top"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <View
        android:id="@+id/pinnedNoteDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/pinned_note_dot"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/noteText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:textColor="@color/launcher_text"
        android:textSize="18sp" />

    <ImageButton
        android:id="@+id/copyNoteButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/copy_note"
        android:padding="12dp"
        android:src="@drawable/ic_content_copy"
        app:tint="@color/launcher_text" />

</LinearLayout>
