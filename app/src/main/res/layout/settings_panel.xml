<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/settingsBackButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings_back"
            android:padding="20dp"
            android:src="@drawable/ic_arrow_back"
            android:visibility="invisible"
            app:tint="@color/launcher_text" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/launcher_settings"
            android:textColor="@color/launcher_text"
            android:textSize="@dimen/app_page_title_text_size" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settingsIndex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settingsAppearanceCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingStart="24dp"
                    android:paddingBottom="12dp"
                    android:paddingEnd="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_category_appearance"
                            android:textColor="@color/launcher_text"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/settings_category_appearance_summary"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/launcher_text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@color/settings_option_divider" />

                <LinearLayout
                    android:id="@+id/settingsNotesCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingStart="24dp"
                    android:paddingBottom="12dp"
                    android:paddingEnd="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_category_notes"
                            android:textColor="@color/launcher_text"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/settings_category_notes_summary"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/launcher_text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@color/settings_option_divider" />

                <LinearLayout
                    android:id="@+id/settingsCalendarCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingStart="24dp"
                    android:paddingBottom="12dp"
                    android:paddingEnd="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_category_calendar"
                            android:textColor="@color/launcher_text"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/settings_category_calendar_summary"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/launcher_text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@color/settings_option_divider" />

                <LinearLayout
                    android:id="@+id/settingsGesturesCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingStart="24dp"
                    android:paddingBottom="12dp"
                    android:paddingEnd="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_category_gestures"
                            android:textColor="@color/launcher_text"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/settings_category_gestures_summary"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/launcher_text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@color/settings_option_divider" />

                <LinearLayout
                    android:id="@+id/settingsScreenTimeCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingStart="24dp"
                    android:paddingBottom="12dp"
                    android:paddingEnd="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_category_screen_time"
                            android:textColor="@color/launcher_text"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/settings_category_screen_time_summary"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/launcher_text_secondary" />

                </LinearLayout>

            </LinearLayout>

            <include
                android:id="@+id/settingsAppearancePanel"
                layout="@layout/settings_appearance_panel" />

            <LinearLayout
                android:id="@+id/settingsNotesPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

    <LinearLayout
        android:id="@+id/showNotesPageRow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/show_notes_page"
            android:textColor="@color/launcher_text"
            android:textSize="17sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showNotesPageSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:background="@color/settings_option_divider" />

    <LinearLayout
        android:id="@+id/notesTrashRow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/notes_trash_title"
            android:textColor="@color/launcher_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/notesTrashCount"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsCalendarPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

    <LinearLayout
        android:id="@+id/showTodayPageRow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/show_today_page"
            android:textColor="@color/launcher_text"
            android:textSize="17sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showTodayPageSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:background="@color/settings_option_divider" />

    <LinearLayout
        android:id="@+id/showCalendarPageRow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/show_calendar_page"
            android:textColor="@color/launcher_text"
            android:textSize="17sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showCalendarPageSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:background="@color/settings_option_divider" />

    <TextView
        android:id="@+id/calendarSelectionHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/calendar_selection_title"
        android:textColor="@color/launcher_text"
        android:textSize="17sp"
        app:drawableEndCompat="@drawable/ic_expand_more"
        app:drawableTint="@color/launcher_text" />

    <TextView
        android:id="@+id/calendarSelectionHint"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:text="@string/calendar_selection_permission_hint"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/calendarSelectionList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsGesturesPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

    <LinearLayout
        android:id="@+id/openScreenTimeGestureRow"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/gesture_action_open_screen_time"
            android:textColor="@color/launcher_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/openScreenTimeGestureValue"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="15sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:background="@color/settings_option_divider" />

    <LinearLayout
        android:id="@+id/lockScreenGestureRow"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/gesture_action_lock_screen"
            android:textColor="@color/launcher_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/lockScreenGestureValue"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="15sp" />

    </LinearLayout>

            </LinearLayout>

            <include
                android:id="@+id/settingsScreenTimePanel"
                layout="@layout/settings_screen_time_panel" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
