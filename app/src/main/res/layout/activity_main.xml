<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true">

    <View
        android:id="@+id/wallpaperDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <LinearLayout
                android:id="@+id/clockDateContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:orientation="vertical">

                <com.example.textlauncher.ui.AnalogClockView
                    android:id="@+id/clockView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:paddingStart="24dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/launcher_text"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/editModeText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/edit_mode_label"
                android:textColor="@color/launcher_text"
                android:textSize="34sp"
                android:visibility="gone" />

        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shortcutList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:longClickable="true"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/quickAccessBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:minHeight="70dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <ImageButton
                android:id="@+id/leftQuickAccessButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/quick_access_button_background"
                android:contentDescription="@string/quick_access_left"
                android:padding="13dp"
                android:src="@drawable/ic_camera_line" />

            <View
                android:id="@+id/quickAccessSpacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/rightQuickAccessButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/quick_access_button_background"
                android:contentDescription="@string/quick_access_right"
                android:padding="13dp"
                android:src="@drawable/ic_note_line" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/homeTransitionDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/calendarRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/calendarTitle"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="@string/calendar_page_title"
            android:textColor="@color/launcher_text"
            android:textSize="@dimen/app_page_title_text_size" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calendarEventList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingHorizontal="24dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/calendarEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/calendar_empty"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="17sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/calendarPermissionPrompt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/calendar_permission_prompt"
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/calendarPermissionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="@string/calendar_permission_button"
                    android:textColor="@color/launcher_text"
                    android:textSize="17sp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/notesRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/notesHeader"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/notesTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical|start"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/notes_page_title"
                android:textColor="@color/launcher_text"
                android:textSize="@dimen/app_page_title_text_size" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notesList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingHorizontal="24dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/notesEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/notes_empty"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="17sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/addNoteButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/add_note"
                android:padding="13dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/launcher_text" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/todayRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/todayHeader"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/todayTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical|start"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/today_page_title"
                android:textColor="@color/launcher_text"
                android:textSize="@dimen/app_page_title_text_size" />

            <ImageButton
                android:id="@+id/addTodayWidgetButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical|end"
                android:background="@android:color/transparent"
                android:contentDescription="@string/today_add_widget"
                android:padding="13dp"
                android:src="@drawable/ic_add"
                android:visibility="gone"
                app:tint="@color/launcher_text" />

        </FrameLayout>

        <com.example.textlauncher.ui.TodayWidgetGridView
            android:id="@+id/todayWidgetGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />

    </LinearLayout>

    <include
        android:id="@+id/screenTimePanel"
        layout="@layout/screen_time_panel" />

    <FrameLayout
        android:id="@+id/editControls"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/addShortcutButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/add_shortcut"
            android:padding="9dp"
            android:src="@drawable/ic_add"
            app:tint="@color/launcher_text" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/launcher_settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/launcher_text" />

    </FrameLayout>

    <include
        android:id="@+id/settingsPanel"
        layout="@layout/settings_panel" />

    <LinearLayout
        android:id="@+id/noteTrashRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="@string/notes_trash_title"
            android:textColor="@color/launcher_text"
            android:textSize="@dimen/app_page_title_text_size" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/noteTrashList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingHorizontal="24dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/noteTrashEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/notes_trash_empty"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="17sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/noteEditorRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/noteEditorInput"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="@string/note_editor_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingTop="24dp"
            android:textColor="@color/launcher_text"
            android:textColorHint="@color/launcher_text_secondary"
            android:textSize="19sp" />

        <LinearLayout
            android:id="@+id/noteEditorActions"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancelNoteEditButton"
                android:layout_width="96dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="@string/cancel_note_edit"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/saveNoteButton"
                android:layout_width="96dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="@string/save_note"
                android:textColor="@color/launcher_text"
                android:textSize="17sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/appPickerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/appSearchInput"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="24dp"
            android:singleLine="true"
            android:textColor="@color/launcher_text"
            android:textColorHint="@color/launcher_text_secondary"
            android:textSize="20sp" />

        <View
            android:id="@+id/appSearchDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="24dp"
            android:background="@color/launcher_text" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appPickerList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="48dp" />

            <TextView
                android:id="@+id/appPickerEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/app_picker_empty"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="17sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/appBlockPromptRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/appBlockPromptContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/note_editor_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/appBlockPromptTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/launcher_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/appBlockPromptMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/app_blocking_prompt_message"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/appBlockIntentionPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/app_blocking_intention_prompt"
                android:textColor="@color/launcher_text"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/appBlockIntentionOptions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/appBlockIntent5Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/app_blocking_intention_5"
                    android:textColor="@color/launcher_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/appBlockIntent10Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/app_blocking_intention_10"
                    android:textColor="@color/launcher_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/appBlockIntent15Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/app_blocking_intention_15"
                    android:textColor="@color/launcher_text"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/appBlockPromptActions"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/appBlockCancelButton"
                    android:layout_width="96dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="@string/app_blocking_cancel"
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/appBlockProceedButton"
                    android:layout_width="128dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:textColor="@color/launcher_text"
                    android:textSize="17sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/gesturePickerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:contentDescription="@string/gesture_picker_close"
        android:focusable="true"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/gesturePickerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/gesture_picker_panel_background"
            android:orientation="vertical"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/gesturePickerTitle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="22dp"
                android:textColor="@color/launcher_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gestureNoneOption"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/gesture_none"
                android:textColor="@color/launcher_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/gestureTwoFingerSwipeDownOption"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/gesture_two_finger_swipe_down"
                android:textColor="@color/launcher_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/gestureDoubleTapOption"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/gesture_double_tap"
                android:textColor="@color/launcher_text"
                android:textSize="17sp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/noteUndoContainer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/note_undo_background"
        android:clickable="true"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/noteUndoMessage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:accessibilityLiveRegion="polite"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/note_moved_to_trash"
            android:textColor="@color/launcher_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/noteUndoButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="10dp"
            android:text="@string/undo_note_delete"
            android:textColor="@color/launcher_text"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
